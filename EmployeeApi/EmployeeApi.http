@EmployeeApi_HostAddress = http://localhost:5256
@Username = admin
@Password = admin123

POST {{EmployeeApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "{{Username}}",
  "password": "{{Password}}"
}

###

GET {{EmployeeApi_HostAddress}}/api/employee
Accept: application/json
Authorization: Bearer {{Token}}

###

GET {{EmployeeApi_HostAddress}}/api/employee/1
Accept: application/json
Authorization: Bearer {{Token}}

###

